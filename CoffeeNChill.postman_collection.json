{
  "info": {
    "_postman_id": "coffee-n-chill-part3",
    "name": "CoffeeNChill API Gateway & Functions",
    "description": "Postman collection for the CoffeeNChill API Gateway (Auth/RBAC, Menu, Orders, and Staff Documents). Use http://localhost:5197/api locally or http://<vps-ip>:5000/api for the live VPS demo.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5197/api"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "customerToken",
      "value": ""
    },
    {
      "key": "category",
      "value": "HotDrinks"
    },
    {
      "key": "id",
      "value": "coffee001"
    },
    {
      "key": "fileName",
      "value": "staff-document.pdf"
    },
    {
      "key": "orderDate",
      "value": "2026-10-10"
    },
    {
      "key": "orderId",
      "value": "ORD-2026-8801"
    }
  ],
  "item": [
    {
      "name": "AUTH & RBAC",
      "item": [
        {
          "name": "1 - Register Customer",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Jane Customer\",\n  \"email\": \"customer@coffeenchill.com\",\n  \"password\": \"Password123!\",\n  \"role\": \"Customer\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            }
          }
        },
        {
          "name": "2 - Register Staff",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Taahir Staff\",\n  \"email\": \"staff@coffeenchill.com\",\n  \"password\": \"Password123!\",\n  \"role\": \"Staff\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            }
          }
        },
        {
          "name": "3 - Login Customer",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "if (jsonData.token) {",
                  "    pm.collectionVariables.set(\"token\", jsonData.token);",
                  "    pm.collectionVariables.set(\"customerToken\", jsonData.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"customer@coffeenchill.com\",\n  \"password\": \"Password123!\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            }
          }
        },
        {
          "name": "4 - Customer Rejected on Staff Endpoint (403 Forbidden)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Customer token is rejected with 403 Forbidden on Staff-only endpoint\", function () {",
                  "    pm.response.to.have.status(403);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"partitionKey\": \"HotDrinks\",\n  \"rowKey\": \"coffee999\",\n  \"name\": \"Unauthorized Espresso\",\n  \"description\": \"Should be rejected with 403 Forbidden\",\n  \"price\": 30.00,\n  \"isAvailable\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/menu",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "menu"
              ]
            }
          }
        },
        {
          "name": "5 - Login Staff (Saves {{token}})",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "if (jsonData.token) {",
                  "    pm.collectionVariables.set(\"token\", jsonData.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"staff@coffeenchill.com\",\n  \"password\": \"Password123!\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            }
          }
        },
        {
          "name": "6 - Get Current User (/api/auth/me)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "me"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "MENU",
      "item": [
        {
          "name": "1 - Create Menu Item",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"partitionKey\": \"HotDrinks\",\n  \"rowKey\": \"coffee001\",\n  \"name\": \"Cappuccino\",\n  \"description\": \"Espresso with steamed milk and foam\",\n  \"price\": 35.00,\n  \"isAvailable\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/menu",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "menu"
              ]
            }
          }
        },
        {
          "name": "2 - Get All Menu Items",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/menu",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "menu"
              ]
            }
          }
        },
        {
          "name": "3 - Get Menu Items By Category",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/menu/category/{{category}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "menu",
                "category",
                "{{category}}"
              ]
            }
          }
        },
        {
          "name": "4 - Update Menu Item",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Large Cappuccino\",\n  \"description\": \"Large espresso with steamed milk and foam\",\n  \"price\": 40.00,\n  \"isAvailable\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/menu/{{category}}/{{id}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "menu",
                "{{category}}",
                "{{id}}"
              ]
            }
          }
        },
        {
          "name": "5 - Delete Menu Item",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/menu/{{category}}/{{id}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "menu",
                "{{category}}",
                "{{id}}"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "STAFF DOCUMENTS",
      "item": [
        {
          "name": "6 - Upload Staff Document",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": ""
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/documents/upload",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "documents",
                "upload"
              ]
            }
          }
        },
        {
          "name": "7 - List Staff Documents",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
