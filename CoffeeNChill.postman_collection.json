          }
        }
      ]
    },
    {
      "name": "ORDERS",
      "item": [
        {
          "name": "10 - Queue Order",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"OrderId\": \"ORD-2026-8801\",\n  \"CustomerName\": \"Jane Smith\",\n  \"SelectedItemSKUs\": [\n    \"COF-001\",\n    \"PAS-104\"\n  ],\n  \"TotalPrice\": 65.0,\n  \"OrderTimestamp\": \"2026-10-10T10:15:00Z\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/orders/queue",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "orders",
                "queue"
              ]
            }
          }
        },
        {
          "name": "11 - Check Order Status",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/orders/{{orderDate}}/{{orderId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "orders",
                "{{orderDate}}",
                "{{orderId}}"
              ]
            }
          }
        },
        {
          "name": "12 - Update Order Status",
          "request": {
            "method": "PUT",
            "header": [
